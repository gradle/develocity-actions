{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "rootDir": "..",
    "rootDirs": [
      "./src",
      "../build-scan-shared/src",
      "../setup-docker/src",
      "../setup-maven/src",
      "../setup-npm/src",
      "../setup-python/src"
    ],
    "moduleResolution": "bundler",
    "sourceMap": true,
    "outDir": "./dist",
    "noImplicitAny": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "newLine": "lf",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "./dist",
    "./node_modules",
    "./__tests__",
    "./coverage"
  ]
}
